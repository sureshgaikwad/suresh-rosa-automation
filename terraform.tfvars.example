# Example terraform.tfvars file
# Copy this file to terraform.tfvars and update the values

##############################################################
# Required Variables
##############################################################
cluster_name      = "my-rosa-cluster"
openshift_version = "4.17.0"
aws_region        = "us-east-1"

# AWS Account Configuration (optional - will auto-detect if not provided)
# aws_account_id         = "123456789012"  # AWS account where cluster will be deployed
# aws_billing_account_id = "123456789012"  # AWS account for billing (defaults to aws_account_id)

##############################################################
# VPC Configuration
##############################################################
create_vpc = true
vpc_cidr   = "10.0.0.0/16"

# If using existing VPC, set create_vpc = false and provide:
# IMPORTANT: For private ROSA HCP clusters, provide PRIVATE subnet IDs only.
# For public clusters, provide both public and private subnets.
# aws_subnet_ids         = ["subnet-private1", "subnet-private2", "subnet-private3"]
# aws_availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
# machine_cidr           = "10.0.0.0/16"

##############################################################
# Zero Egress Configuration (Air-gapped / Disconnected Cluster)
##############################################################
# Enable zero egress for a fully private cluster with no internet access
zero_egress                      = false
zero_egress_vpc_endpoints        = true   # Create required AWS VPC endpoints
zero_egress_additional_endpoints = []     # Additional endpoints: ["sqs", "sns", "kinesis"]

# Note: When zero_egress = true:
# - VPC will only have private subnets (no internet gateway)
# - VPC endpoints will be created for: ec2, ecr.api, ecr.dkr, s3, sts, elasticloadbalancing, kms, logs, secretsmanager
# - Cluster will be private with internal ingress
# - Image mirroring may be required for disconnected operation

##############################################################
# Admin User Configuration
##############################################################
admin_username = "cluster-admin"
# admin_credentials_password = "YourSecurePassword123!" # Optional, random password will be generated if not provided

##############################################################
# Cluster Configuration
##############################################################
private_cluster      = false
compute_machine_type = "m5.xlarge"
replicas             = 3   # Number of worker nodes (must be multiple of AZ count for HCP)

# Cluster Wait Configuration
wait_for_create_complete            = true  # Wait for cluster API to be ready (20 min timeout)
wait_for_std_compute_nodes_complete = true  # Wait for all compute nodes to be ready (60 min timeout)
# Destroy: keep false so Terraform waits for the cluster to be fully deleted before removing VPC/OIDC
disable_waiting_in_destroy = false   # Must be false for clean destroy (default)
destroy_timeout            = 90     # Max minutes for cluster destroy (default 60); increase if destroy fails

##############################################################
# Optional Network Configuration
##############################################################
# service_cidr = "172.30.0.0/16"
# pod_cidr     = "10.128.0.0/14"
# host_prefix  = 23

##############################################################
# Machine Pools Configuration
##############################################################
create_additional_machine_pools = false
enable_autoscaling              = false
autoscaling_min_replicas        = 2
autoscaling_max_replicas        = 10

# Example additional machine pools configuration:
# machine_pools = {
#   "worker-pool-1" = {
#     name = "worker-pool-1"
#     aws_node_pool = {
#       instance_type = "m5.2xlarge"
#       tags          = {}
#     }
#     replicas    = 3
#     auto_repair = true
#     labels = {
#       "node-type" = "compute"
#     }
#     # Optional autoscaling configuration (replicas is ignored when autoscaling is set)
#     # autoscaling = {
#     #   min_replicas = 2
#     #   max_replicas = 5
#     # }
#   }
#   "gpu-pool" = {
#     name = "gpu-pool"
#     aws_node_pool = {
#       # Use g4dn.8xlarge or larger for AI model pods that request ~20 CPU + 80Gi (e.g. Mistral); g4dn.xlarge has only 4 CPU / 16Gi
#       instance_type = "g4dn.8xlarge"
#       tags          = {}
#     }
#     replicas    = 2
#     auto_repair = true
#     labels = {
#       "node-type" = "gpu"
#     }
#     taints = [
#       {
#         key           = "nvidia.com/gpu"
#         value         = "true"
#         schedule_type = "NoSchedule"
#       }
#     ]
#   }
# }

##############################################################
# Bastion Host Configuration
##############################################################
create_bastion_host   = false
bastion_instance_type = "t3.micro"
# bastion_ssh_key_name = "my-key-pair"  # Required if create_bastion_host = true

##############################################################
# Identity Providers Configuration
##############################################################
create_identity_providers = false

# Example identity providers configuration:
# identity_providers = {
#   "github-idp" = {
#     name                     = "github-corp"
#     idp_type                 = "github"
#     github_idp_client_id     = "your-github-client-id"
#     github_idp_client_secret = "your-github-client-secret"
#     # Native HCL types (preferred)
#     github_idp_organizations = ["your-github-org"]
#     mapping_method           = "claim"
#   }
#   "htpasswd-idp" = {
#     name             = "local-users"
#     idp_type         = "htpasswd"
#     # Native HCL types (preferred)
#     htpasswd_idp_users = [
#       {
#         username = "admin"
#         password = "secure-password"
#       }
#     ]
#   }
# }

##############################################################
# Roles and OIDC Configuration
##############################################################
create_account_roles  = true
create_operator_roles = true
create_oidc           = true
managed_oidc          = true
create_ocm_role       = false
# ocm_role_name       = "ManagedOpenShift-OCM-Role"

##############################################################
# Encryption Configuration
##############################################################
enable_etcd_encryption = false
enable_ebs_encryption  = false
# etcd_kms_key_arn     = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"
# kms_key_arn          = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"

##############################################################
# Proxy Configuration
##############################################################
enable_proxy = false
# http_proxy              = "http://proxy.company.com:8080"
# https_proxy             = "https://proxy.company.com:8080"
# no_proxy                = "localhost,127.0.0.1,.company.com"
# additional_trust_bundle = "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

##############################################################
# Red Hat Cloud Services (RHCS) Authentication
##############################################################
# Option 1: Use RHCS Token (recommended for personal use)
# rhcs_token = "eyJhbGc..." # Get from https://console.redhat.com/openshift/token

# Option 2: Use Service Account credentials (recommended for automation)
# rhcs_client_id     = "your-rhcs-client-id"
# rhcs_client_secret = "your-rhcs-client-secret"

# Option 3: Use environment variables (most secure)
# export RHCS_TOKEN="your-token"
# OR
# export RHCS_CLIENT_ID="your-client-id"
# export RHCS_CLIENT_SECRET="your-client-secret"

# Optional: Custom OCM URL (default is production)
# rhcs_url = "https://api.stage.openshift.com"  # For staging environment

##############################################################
# OpenShift GitOps Configuration
##############################################################
deploy_openshift_gitops = true
deploy_vote_application = true
gitops_repo_url         = "https://github.com/sureshgaikwad/gitops-catalog"
application_repo_path   = "application/vote-application"

##############################################################
# Operator Deployments (via ArgoCD)
##############################################################

# AI/ML Operators
deploy_openshift_ai                    = false
deploy_ai_model                        = false
deploy_openshift_lightspeed            = false

# GPU/Hardware Operators
deploy_nfd                             = false
deploy_nfd_application                 = false
deploy_nvidia_gpu_operator             = false
deploy_nvidia_gpu_operator_application = false

# Service Mesh & Serverless
deploy_openshift_serverless            = false
deploy_openshift_servicemesh           = false

# Security & Auth
deploy_authorino_operator              = false
deploy_keycloak                        = false
keycloak_wait_timeout                  = 600  # Increase (e.g. 900) if Keycloak pod starts slowly

# Developer Tools
deploy_developerhub                    = false
deploy_openshift_devspaces             = false
deploy_web_terminal                    = false

# Infrastructure & Management
deploy_openshift_virtualization        = false
deploy_advance_cluster_management      = false

##############################################################
# Tags
##############################################################
tags = {
  Environment = "development"
  Team        = "platform"
  Project     = "rosa-cluster"
}
